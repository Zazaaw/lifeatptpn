# Salin ke .env lalu isi. Lihat README.md.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key, rahasia>

# Tidak dipakai aplikasi; token aktif ada di Supabase Vault `ig_access_token`.
INSTAGRAM_ACCESS_TOKEN=

# PIN untuk mengubah jadwal di menu Rencana (minimal 4 karakter).
# Tanpa ini, kalender tetap bisa dibaca tetapi tidak bisa diubah dari web.
PLAN_EDIT_PIN=
